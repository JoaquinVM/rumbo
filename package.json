{
  "name": "rumbo",
  "private": true,
  "type": "module",
  "workspaces": [
    "paquetes/dominio",
    "paquetes/contratos",
    "app",
    "servidor",
    "migracion",
    "e2e"
  ],
  "scripts": {
    "verificar": "node pruebas/verificar.mjs && node pruebas/nube.mjs && node pruebas/servidor-pagina.mjs",
    "probar-servidor": "node --test pruebas/servidor.test.mjs",
    "tipos": "tsc --noEmit -p . && npm run tipos --workspaces --if-present",
    "capas": "depcruise paquetes app/src migracion/src --config .dependency-cruiser.cjs",
    "unitarias": "vitest run",
    "construir": "npm run construir -w @rumbo/app",
    "e2e": "npm run e2e -w @rumbo/e2e",
    "lighthouse": "npm run lighthouse -w @rumbo/e2e"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "dependency-cruiser": "17.4.3",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
