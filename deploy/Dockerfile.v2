# Rumbo 2's image (design.md «CI/CD», PUB-01, PUB-02): it builds the page (app) and the server (servidor/src) and keeps
# only what runs, as the unprivileged `node` user. It is not deployed until the cut (job 080): deploy/docker-compose.yml
# still builds deploy/Dockerfile, the v1. Only the files in Dockerfile.v2.dockerignore reach the build, so the fake
# Access of the e2e tests (e2e/servidor-prueba.mjs) never gets in; pruebas/imagen-v2.sh checks it in the CI.
# Build: docker build -f deploy/Dockerfile.v2 -t rumbo-v2 .

# 1 · Build the page and the server with every dependency they need
FROM node:24.21.0-alpine3.24 AS construir
WORKDIR /src
COPY package.json package-lock.json tsconfig.base.json ./
COPY paquetes/dominio/package.json paquetes/dominio/
COPY paquetes/contratos/package.json paquetes/contratos/
COPY app/package.json app/
COPY servidor/package.json servidor/
COPY migracion/package.json migracion/
COPY e2e/package.json e2e/
RUN npm ci --no-audit --no-fund --include-workspace-root \
      -w @rumbo/dominio -w @rumbo/contratos -w @rumbo/app -w rumbo-servidor
COPY paquetes paquetes
COPY app app
COPY servidor servidor
RUN npm run construir && npm run construir-servidor

# 2 · Only what the server needs to run: pg and zod
FROM node:24.21.0-alpine3.24 AS dependencias
WORKDIR /src
COPY package.json package-lock.json ./
COPY paquetes/dominio/package.json paquetes/dominio/
COPY paquetes/contratos/package.json paquetes/contratos/
COPY app/package.json app/
COPY servidor/package.json servidor/
COPY migracion/package.json migracion/
COPY e2e/package.json e2e/
RUN npm ci --omit=dev --no-audit --no-fund -w @rumbo/contratos -w rumbo-servidor && npm cache clean --force

# 3 · What runs
FROM node:24.21.0-alpine3.24
WORKDIR /app
COPY --from=dependencias /src/node_modules node_modules
COPY paquetes/contratos/package.json paquetes/contratos/
COPY --from=construir /src/paquetes/contratos/dist paquetes/contratos/dist
COPY servidor/package.json servidor/
COPY --from=construir /src/servidor/dist servidor/dist
COPY --from=construir /src/app/dist app/dist
ENV NODE_ENV=production PORT=8080
USER node
EXPOSE 8080
CMD ["node", "--conditions=rumbo-compilado", "servidor/dist/principal.js"]
