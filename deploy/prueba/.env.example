# Rumbo 2's test environment: /opt/apps/rumbo-prueba/.env, mode 600, owned by root. prueba.sh base creates it with
# the database password and the Access team; the rest is filled by hand. Never versioned with values.
DB_PASSWORD=
ACCESS_TEAM=
# AUD tag of the Access application rumbo-prueba.jviscafe.com (not the one of rumbo.jviscafe.com)
ACCESS_AUD=
# Only Joaquín's email: only that person's data are copied into the test environment
CORREOS_PERMITIDOS=
TZ=America/La_Paz
