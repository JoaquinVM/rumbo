# Rumbo on the VPS: /opt/apps/rumbo/.env, mode 600, owned by root (docs/DESPLIEGUE.md). Never versioned with values.
# Keep a copy in the password manager.

# PostgreSQL of Rumbo (only on its internal network). Generate with: openssl rand -hex 24
DB_PASSWORD=

# Cloudflare Access (PUB-01): team name (the part before .cloudflareaccess.com) and the AUD tag of the application
# rumbo.jviscafe.com (Zero Trust > Access > Applications > Rumbo > Overview)
ACCESS_TEAM=
ACCESS_AUD=
# Same emails as the Access policy, separated by commas: the server rejects any other one even if Access lets it in
CORREOS_PERMITIDOS=

TZ=America/La_Paz

# Encrypted backup off the VPS (PUB-03): crypt remote of /opt/apps/rclone.conf, over apps/rumbo in B2
BACKUP_REMOTE=rumbo-crypt:

# healthchecks.io (PUB-04): daily backup, weekly restore check and deploy/health every 2 minutes
HEALTHCHECK_BACKUP_URL=
HEALTHCHECK_RESTORE_URL=
HEALTHCHECK_DEPLOY_URL=
